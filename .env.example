# MongoDB Connection Strings (one per service database)
MONGO_URL_FOOD=mongodb+srv://username:password@cluster.mongodb.net/food-db
MONGO_URL_USER=mongodb+srv://username:password@cluster.mongodb.net/user-db
MONGO_URL_CART=mongodb+srv://username:password@cluster.mongodb.net/cart-db
MONGO_URL_ORDER=mongodb+srv://username:password@cluster.mongodb.net/order-db

# Shared JWT Secret (must be same across all services)
JWT_SECRET=your_jwt_secret_here

# Bcrypt salt rounds (user-service)
SALT=10

# Stripe (order-service)
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# Frontend URL (for Stripe redirect callbacks)
FRONTEND_URL=http://localhost:3000
